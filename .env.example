# EVOLVE Phase 2 configuration.
#
# Copy this file to `.env.local` (which is gitignored) and fill in what you need.
# The engine loads `.env.local` first, then `.env`, and never overrides values
# that are already present in the real environment.
#
# PAPER TRADING ONLY: none of these settings can enable real execution. There is
# no wallet key, signer, or order-submission path anywhere in this repository.

# ---------------------------------------------------------------------------
# Jupiter market observation (read-only, server-side only)
# ---------------------------------------------------------------------------
# Used exclusively as an `x-api-key` request header by the Node engine.
# Never printed, never sent to the browser, never included in API responses.
# Leave empty to run keyless (subject to Jupiter's keyless rate limits) or to
# run synthetic-only.
JUPITER_API_KEY=

# auto      -> use live Jupiter observations; fall back to synthetic EXPLICITLY
#               when live data is unavailable
# live      -> require live observations; if unavailable, report
#               "LIVE FEED DEGRADED • NEW ENTRIES PAUSED" (never silently
#               switches to synthetic data)
# synthetic -> Phase 1 simulator only, clearly labelled synthetic
EVOLVE_MARKET_MODE=auto

# Live data older than this counts as stale: new paper entries pause.
EVOLVE_LIVE_STALE_MS=60000

# Rolling deduplicated token universe size (mints).
EVOLVE_MARKET_UNIVERSE_MAX=150

# ---------------------------------------------------------------------------
# Paper trading accounting (simulated only)
# ---------------------------------------------------------------------------
# Normalized starting paper bankroll per agent, per generation.
EVOLVE_PAPER_STARTING_CASH=100

# Base simulated trading cost, in basis points of notional.
EVOLVE_PAPER_BASE_FEE_BPS=10

# Minimum simulated slippage, in basis points (liquidity impact stacks on top).
EVOLVE_PAPER_MIN_SLIPPAGE_BPS=20

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown)
# ---------------------------------------------------------------------------
#EVOLVE_POPULATION=96
#EVOLVE_GENERATION_TICKS=180
#EVOLVE_TICK_MS=900

#EVOLVE_JUPITER_POLL_MS=3000
#EVOLVE_JUPITER_TIMEOUT_MS=9000
#EVOLVE_JUPITER_MIN_BACKOFF_MS=3000
#EVOLVE_JUPITER_MAX_BACKOFF_MS=120000
#EVOLVE_JUPITER_LIMIT=100
#EVOLVE_ALLOW_KEYLESS=true

#EVOLVE_MARKET_TOKEN_TTL_MS=300000
#EVOLVE_AUTO_FALLBACK_FAILURES=4
#EVOLVE_SYNTHETIC_RETRY_MS=90000
#EVOLVE_SYNTHETIC_UNIVERSE=24
#EVOLVE_MIN_LIQUIDITY_USD=2500

#EVOLVE_PAPER_SLIPPAGE_IMPACT=0.6
#EVOLVE_PAPER_SLIPPAGE_CAP_BPS=400
#EVOLVE_PAPER_ADVERSE_BPS=8
#EVOLVE_PAPER_MAX_LIQUIDITY_FRACTION=0.02
#EVOLVE_PAPER_MAX_POSITION_FRACTION=0.28

# Phase 3 will need a read-only Solana RPC for observation. No execution.
HELIUS_API_KEY=
