# EVOLVE Phase 2 configuration.
#
# Copy this file to `.env.local` (which is gitignored) and fill in what you need.
# The engine loads `.env.local` first, then `.env`, and never overrides values
# that are already present in the real environment.
#
# PAPER TRADING ONLY: none of these settings can enable real execution. There is
# no wallet key, signer, or order-submission path anywhere in this repository.

# ---------------------------------------------------------------------------
# Jupiter market observation (read-only, server-side only)
# ---------------------------------------------------------------------------
# Used exclusively as an `x-api-key` request header by the Node engine.
# Never printed, never sent to the browser, never included in API responses.
# Leave empty to run keyless (subject to Jupiter's keyless rate limits) or to
# run synthetic-only.
JUPITER_API_KEY=

# auto      -> use live Jupiter observations; fall back to synthetic EXPLICITLY
#               when live data is unavailable
# live      -> require live observations; if unavailable, report
#               "LIVE FEED DEGRADED • NEW ENTRIES PAUSED" (never silently
#               switches to synthetic data)
# synthetic -> Phase 1 simulator only, clearly labelled synthetic
EVOLVE_MARKET_MODE=auto

# Live data older than this counts as stale: new paper entries pause.
EVOLVE_LIVE_STALE_MS=60000

# Rolling deduplicated token universe size (mints).
EVOLVE_MARKET_UNIVERSE_MAX=150

# ---------------------------------------------------------------------------
# Paper trading accounting (simulated only)
# ---------------------------------------------------------------------------
# Normalized starting paper bankroll per agent, per generation.
EVOLVE_PAPER_STARTING_CASH=100

# Base simulated trading cost, in basis points of notional.
EVOLVE_PAPER_BASE_FEE_BPS=10

# Minimum simulated slippage, in basis points (liquidity impact stacks on top).
EVOLVE_PAPER_MIN_SLIPPAGE_BPS=20

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown)
# ---------------------------------------------------------------------------
#EVOLVE_POPULATION=96
#EVOLVE_GENERATION_TICKS=180
#EVOLVE_TICK_MS=900

#EVOLVE_JUPITER_POLL_MS=3000
#EVOLVE_JUPITER_TIMEOUT_MS=9000
#EVOLVE_JUPITER_MIN_BACKOFF_MS=3000
#EVOLVE_JUPITER_MAX_BACKOFF_MS=120000
#EVOLVE_JUPITER_LIMIT=100
#EVOLVE_ALLOW_KEYLESS=true

#EVOLVE_MARKET_TOKEN_TTL_MS=300000
#EVOLVE_AUTO_FALLBACK_FAILURES=4
#EVOLVE_SYNTHETIC_RETRY_MS=90000
#EVOLVE_SYNTHETIC_UNIVERSE=24
#EVOLVE_MIN_LIQUIDITY_USD=2500

#EVOLVE_PAPER_SLIPPAGE_IMPACT=0.6
#EVOLVE_PAPER_SLIPPAGE_CAP_BPS=400
#EVOLVE_PAPER_ADVERSE_BPS=8
#EVOLVE_PAPER_MAX_LIQUIDITY_FRACTION=0.02
#EVOLVE_PAPER_MAX_POSITION_FRACTION=0.28

# ---------------------------------------------------------------------------
# Phase 3: historical capture, deterministic replay, walk-forward research
# ---------------------------------------------------------------------------
# Historical datasets and experiment reports are written under .evolve/, which
# is gitignored. No database is required, and no RPC endpoint is used: replay
# reads recorded observations from disk. Nothing here can trade or execute.

# Seed for the deterministic replay/experiment. Same dataset + config + seed
# reproduces the same population, decisions, fills and generations.
#EVOLVE_SEED=evolve

# Multiple seeds make a claim about behaviour, not luck. Comma separated.
#EVOLVE_EVAL_SEEDS=11,22,33,44,55

# Where recorded datasets live, and how often the recorder captures a snapshot.
#EVOLVE_HISTORY_ROOT=.evolve/history
#EVOLVE_RECORD_INTERVAL_MS=5000
#EVOLVE_RECORD_MANIFEST_EVERY=12

# Replay: dataset directory, wall-clock pacing ("max" = unthrottled), and whether
# already-recorded data is enough to trust the run.
#EVOLVE_REPLAY_DATASET=
#EVOLVE_REPLAY_SPEED=1
#EVOLVE_REPLAY_PACING=true
#EVOLVE_REPLAY_VERIFY_FINGERPRINT=true
#EVOLVE_REPLAY_STAGE=train
# State isolation: replays write replay-state.json, never the live state.json.
#EVOLVE_REPLAY_STATE_FILE=replay-state.json

# Walk-forward windows (minutes). TRAIN evolves; VALIDATE and TEST are frozen and
# only rank or measure genomes. Windows smaller than the dataset is long are an
# explicit error unless EVOLVE_WF_ALLOW_SHORT_DATASET=true.
#EVOLVE_WF_TRAIN_MINUTES=360
#EVOLVE_WF_VALIDATE_MINUTES=120
#EVOLVE_WF_TEST_MINUTES=120
#EVOLVE_WF_STEP_MINUTES=120
#EVOLVE_WF_MIN_WINDOWS=1
#EVOLVE_WF_MAX_CANDIDATES=8
#EVOLVE_WF_MIN_VALIDATION_ROBUSTNESS=0
#EVOLVE_WF_ALLOW_SHORT_DATASET=false

# Minimum evidence before anything may be called a champion. Below these gates
# the result is reported as INSUFFICIENT SAMPLE, never as validated.
#EVOLVE_MIN_TRADES=20
#EVOLVE_MIN_DISTINCT_MINTS=4
#EVOLVE_MIN_OBSERVATIONS=200
#EVOLVE_MIN_EXPOSURE_TICKS=40

# Champion archive and experiment reports.
#EVOLVE_CHAMPIONS_DIR=.evolve/champions
#EVOLVE_EXPERIMENTS_DIR=.evolve/experiments

# Dashboard state source: auto | live | replay (?source=… overrides per request).
#EVOLVE_DASHBOARD_SOURCE=auto

# Evolutionary operator rates (TRAIN stage only).
#EVOLVE_EVOLUTION_ENABLED=true
#EVOLVE_MUTATION_SCALE=0.07
#EVOLVE_CROSSOVER_RATE=0.48
#EVOLVE_IMMIGRANT_RATE=0.1
#EVOLVE_ELITE_FRACTION=0.1
#EVOLVE_BREEDER_FRACTION=0.28

# Baselines (same snapshots, same simulated friction, no future data).
#EVOLVE_BASELINES_ENABLED=true
#EVOLVE_BASELINE_RANDOM_ENTRY_PROBABILITY=0.02

# --- Phase 5A: strategy islands (soft diversity protection) ------------------
# Islands are NOT held at a hard equal 1/N quota. Births follow each island's
# evidence-adjusted reproductive weight, movement is bounded per generation, and
# every island is clamped into an explicit floor/cap. The global invariant is
# always sum(island populations) == EVOLVE_POPULATION_SIZE.
#
# Initialization is still approximately even (192 -> about 32 each).
#EVOLVE_ISLANDS_ENABLED=true
# Initialization / base weight per island ("Name:count,Name:count").
#EVOLVE_ISLAND_TARGETS=
# Minimum island population as a share of the total (0 = let an island die).
# 0.08 -> 15 agents at 192. Set to 0 to allow real extinction + revival.
#EVOLVE_ISLAND_MIN_SHARE=0.08
# Maximum island population as a share of the total (anti-monoculture cap).
# 0.3 -> 58 agents at 192.
#EVOLVE_ISLAND_MAX_SHARE=0.3
# Maximum share one island's target may move in a single generation
# (anti-takeover bound; 0.06 -> 12 agents at 192).
#EVOLVE_ISLAND_MAX_SHARE_DELTA=0.06
# How strongly an EVIDENCE-BACKED fitness advantage shifts reproductive weight,
# and the fitness scale the advantage saturates at. A lucky, barely-evidenced
# island earns essentially none of this advantage.
#EVOLVE_ISLAND_ADVANTAGE_STRENGTH=0.75
#EVOLVE_ISLAND_FITNESS_SCALE=8
# Bounded migration / cross-species crossover / random immigration.
#EVOLVE_ISLAND_MIGRATION_RATE=0.04
#EVOLVE_ISLAND_MAX_MIGRATIONS=12
#EVOLVE_CROSS_SPECIES_CROSSOVER_RATE=0.05
#EVOLVE_RANDOM_IMMIGRANT_RATE=0.03
#EVOLVE_ISLAND_REVIVE_EXTINCT=true

# --- Phase 5A: controlled research swarm ------------------------------------
# Background research agents propose hypotheses; a deterministic compiler turns
# valid proposals into candidate genomes; the watchdog screens them and the
# Arena (not the swarm) decides anything. Leaving EVOLVE_RESEARCH_PROVIDER
# unset (or empty) uses `mock`: deterministic, offline, no LLM key, no network.
# Provider selection is FAIL-CLOSED (Phase 5B.1) — an explicit name must be
# registered (`mock` or `deepseek-cline`); any other explicit name is a
# configuration error and the run refuses to start. There is NO provider
# fallback during an experiment.
#EVOLVE_RESEARCH_ENABLED=true
#EVOLVE_RESEARCH_PROVIDER=mock
#EVOLVE_RESEARCH_CYCLE_EVERY_GENERATIONS=2
#EVOLVE_RESEARCH_PROPOSALS_PER_CYCLE=6
#EVOLVE_RESEARCH_MAX_COMPILATIONS_PER_CYCLE=3
#EVOLVE_RESEARCH_ROOT=.evolve/research
# Optional credentials for a future external provider. Read from the environment
# only: never persisted to proposals, memory, state, or logs.
#EVOLVE_RESEARCH_API_KEY=
#EVOLVE_LLM_API_KEY=

# --- Phase 5B: optional DeepSeek research provider (Cline CLI) --------------
# Leave EVOLVE_RESEARCH_PROVIDER unset to use `mock`: deterministic, offline, no
# subprocess, no network — the baseline for every offline test. `deepseek-cline`
# is OPTIONAL and must be selected explicitly. Provider selection is FAIL-CLOSED:
# a typo such as `deepseek-clnie` is a configuration error (the run exits
# non-zero, makes no provider call, and creates no experiment artifact) and is
# NEVER served by the mock. A recognized provider that fails at runtime records a
# provider failure status instead of silently generating mock proposals. There is
# no provider fallback of any kind during an experiment.
#EVOLVE_RESEARCH_PROVIDER=mock
#EVOLVE_RESEARCH_MODEL=deepseek/deepseek-v4.1-flash
#EVOLVE_RESEARCH_REASONING=xhigh
# Cline provider profile (-P) and executable. A .mjs/.js path is run via node,
# which is how the offline test stub is wired; the real CLI is `cline`.
#EVOLVE_RESEARCH_CLINE_PROFILE=cline
#EVOLVE_RESEARCH_CLINE_BIN=cline
# Bounded provider call: wall-clock timeout, retry attempts (1 = no retry), and
# an explicit cap on provider calls for a whole research run.
#EVOLVE_RESEARCH_PROVIDER_TIMEOUT_MS=180000
#EVOLVE_RESEARCH_PROVIDER_MAX_ATTEMPTS=1
#EVOLVE_RESEARCH_MAX_PROVIDER_CALLS=12
# Context budget: DeepSeek receives bounded SUMMARIES, never raw datasets.
#EVOLVE_RESEARCH_MAX_CONTEXT_CHARS=12000
#EVOLVE_RESEARCH_MAX_MEMORY_RECORDS=24
# Provider-result cache, keyed by provider+model+reasoning+role+prompt version+
# EVIDENCE DIGEST, so an output can never be reused across a different evidence
# packet. Off by default (an explicit experiment wants a fresh call).
#EVOLVE_RESEARCH_PROVIDER_CACHE=0

# --- Phase 5A.2: research cohort correctness + experimental quality ----------
# A research candidate's canonical identity is digestOf(genome). A compiled
# genome already present in the cohort is deterministically diversified inside
# the region its own proposal declared, or rejected as DUPLICATE_GENOME — it
# never consumes a second Arena slot.

# Minimum fraction of a research cohort that must be genuinely unique genomes.
# Below this the cohort is warned about; with strict mode it is refused.
#EVOLVE_RESEARCH_MIN_UNIQUE_RATIO=0.90

# Maximum share of a research cohort any one species may hold. This is a
# research-DIVERSITY guard, never a performance rule: if the evidence genuinely
# supports concentration and no alternative can be generated, the proposals are
# preserved and an explicit concentration warning is emitted instead of
# fabricating diversity. No Arena gate is ever weakened.
#EVOLVE_RESEARCH_MAX_SPECIES_SHARE=0.60

# Refuse to run an Arena whose research cohort is below the uniqueness minimum.
#EVOLVE_RESEARCH_STRICT_UNIQUENESS=false

# --- Phase 5A.2: Arena research modes ----------------------------------------
# challenger (default): conventional entrants are pre-evolved for
#   EVOLVE_ARENA_GENERATIONS, then fresh research candidates are appended on top
#   of the requested population. Answers "can fresh research ideas beat
#   already-evolved incumbents?".
# fair: ONE mixed cohort — research seeds and conventional seeds receive
#   identical pre-evolution, datasets, seeds, stress profiles, scoring, gates,
#   and generations. Answers "do research-derived lineages do better under
#   equal treatment?".
# ab: TWO matched cohorts (research / conventional) with EQUAL starting slots,
#   identical evolution, identical datasets/windows/seeds/stress, identical
#   scoring and identical gates, and cross-cohort crossover disabled. A
#   shortage shrinks BOTH cohorts symmetrically; a genome is never cloned to
#   fill a slot. Answers "does research-guided initialization beat a matched
#   conventional control under equal resources?". PAPER ONLY.
#   A/B requires at least one unique research seed and one unique conventional
#   seed; otherwise it fails loudly rather than running an unmatched population.
#EVOLVE_ARENA_RESEARCH_MODE=challenger

# Include the persisted research cohort as Arena entrants (`npm run arena --
# --research <dataset>` also works, and `--research-mode fair` implies it).
#EVOLVE_ARENA_INCLUDE_RESEARCH=0

# FAIR mode composition: share of the cohort reserved for research seeds, or an
# explicit count. If fewer UNIQUE research genomes exist than requested, the
# shortfall is REPORTED and absorbed by conventional seeds — genomes are never
# cloned to fill a quota.
#EVOLVE_ARENA_RESEARCH_SHARE=0.5
#EVOLVE_ARENA_RESEARCH_COUNT=

# --- Phase 5A.3: matched A/B benchmark knobs ---------------------------------
# A/B mode is matched by construction. `EVOLVE_ARENA_POPULATION` sets the
# requested TOTAL population; a 50/50 test targets half per cohort, and the
# actual matched size is min(requested per cohort, unique research seeds,
# unique conventional seeds). If only 42 unique research genomes exist, the run
# is 42 vs 42 — never 42 vs 158 — and the shortage is reported.

# Descendant expansion (default OFF). When enabled, each cohort is grown from
# its matched seed count up to the requested per-cohort size by ORDINARY
# evolution under identical rules (identical generations, mutation, crossover,
# immigrant budget). Ancestry is preserved and seed accounting is unchanged.
# This is evolution, NOT cloning: a seed digest still never occupies two slots.
#EVOLVE_ARENA_AB_EXPAND=0

# STRICT species-matched conventional control (default OFF). When enabled, the
# conventional cohort is built from fresh standard species/genome initialization
# whose species counts exactly equal the Research cohort's, and BOTH cohorts are
# then evolved as independent per-species sub-cohorts with identical resources,
# so the distribution cannot drift before the formal freeze. The invariant
# speciesCounts(research) === speciesCounts(conventional) is asserted before
# evaluation: on failure the run stops (no evaluation, no artifact, and never a
# species-matched claim). A species that cannot be filled with unique controls
# shrinks BOTH cohorts symmetrically — never by cloning, never by substitution.
# The report states requestedMatchMode, effectiveMatchMode and matched.
#EVOLVE_ARENA_AB_SPECIES_MATCHED=0

# Deterministic percentile bootstrap for the reported metric differences.
# Fixed iteration count and fixed seed, so the same cohorts always produce the
# same interval. Descriptive only: no significance test is performed and no
# p-value is claimed.
#EVOLVE_ARENA_AB_BOOTSTRAP_ITERATIONS=2000
#EVOLVE_ARENA_AB_BOOTSTRAP_SEED=evolve-ab-bootstrap-v1

# Output: .evolve/arenas/<arena-id>/ab-comparison.json (full report) plus a
# compact `abComparison` block in summary.json. Nothing here is a profitability
# claim, and zero Deployment Candidates remains an acceptable outcome.
